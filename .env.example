# Pooled Neon connection string for the application.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
# Direct Neon connection string for Prisma CLI migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
NEON_AUTH_BASE_URL="https://YOUR_NEON_AUTH_URL"
NEON_AUTH_COOKIE_SECRET="generate-a-random-secret-at-least-32-characters-long"
ADMIN_EMAIL=
ADMIN_PASSWORD=
STATS_PIN=
